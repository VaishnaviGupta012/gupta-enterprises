# ====================================================================
# Gupta Enterprises - Environment Variables
# ====================================================================

# 1. Google Gemini API Key for AI-powered Chatbot
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Supabase Configuration for Enquiries & Chat Query Storage
# Obtain from your Supabase Dashboard: Project Settings -> API
# Note: Use ONLY the public Project URL and Publishable / Anon Key.
# NEVER paste or expose your secret service_role key in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Note: .env and .env.local are ignored by git (see .gitignore)
# Never commit your API keys or secrets to source control.
